{
  "manifest_version": 3,
  "name": "VPN Frontier",
  "version": "6.1.0-android",
  "description": "Block Russian domains when your IP is outside Russia. Mobile-optimized.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vpn-frontier-android@example.com",
      "strict_min_version": "120.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://ifconfig.co/*",
    "https://ipinfo.io/*",
    "https://pro.ip-api.com/*",
    "https://freeipapi.com/*",
    "https://ipwho.is/*",
    "https://api.ipdata.co/*",
    "https://api.ipbase.com/*",
    "https://api.ipgeolocation.io/*",
    "https://api.ip2location.io/*"
  ],
  "background": {
    "scripts": ["lang.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/globe16.png",
      "48": "icons/globe48.png",
      "128": "icons/globe128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "lang.js", "options.html", "options.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/globe16.png",
    "48": "icons/globe48.png",
    "128": "icons/globe128.png"
  }
}
